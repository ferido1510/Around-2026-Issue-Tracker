rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules → Publish.
// Replace the seven emails with your team's Google account emails (lowercase).
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeam() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'teammate1@gmail.com',
          'teammate2@gmail.com',
          'teammate3@gmail.com',
          'teammate4@gmail.com',
          'teammate5@gmail.com',
          'teammate6@gmail.com',
          'teammate7@gmail.com'
        ];
    }

    // One document per task, per sprint: sprints/{sprintId}/tasks/{taskId}
    // (e.g. sprints/sprint-2/tasks/E3.2). No document = nobody took it.
    match /sprints/{sprintId}/tasks/{taskId} {
      allow read: if isTeam();

      // Take a free task: it must be recorded as yours.
      allow create: if isTeam()
        && request.resource.data.keys().hasOnly(['status', 'uid', 'name', 'email', 'startedAt'])
        && request.resource.data.status == 'in-progress'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.startedAt == request.time;

      // Moves between the three states. Nothing but the listed fields may change.
      //
      //   in-progress -> done      tasks with no reviewer: any team member (the
      //                            claimer may have handed it off without releasing it)
      //   in-progress -> review    the assignee says the work is complete
      //   review -> done           the reviewer approves it: it records who, and
      //                            it can't be the person who completed it
      //   review -> in-progress    changes requested, or the assignee takes it back
      //   done -> in-progress      reopened
      //
      // Who is the assignee or the reviewer lives in the sprint file, not in
      // Firestore, so the board enforces that part and these rules enforce the rest.
      allow update: if isTeam() && (
        (resource.data.status == 'in-progress'
          && request.resource.data.status == 'done'
          && request.resource.data.doneAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneAt']))

        || (resource.data.status == 'in-progress'
          && request.resource.data.status == 'review'
          && request.resource.data.reviewAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewAt']))

        || (resource.data.status == 'review'
          && request.resource.data.status == 'done'
          && request.resource.data.doneAt == request.time
          && request.resource.data.reviewerUid == request.auth.uid
          && request.resource.data.reviewerName is string
          && request.resource.data.reviewerName.size() <= 60
          && resource.data.uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'doneAt', 'reviewerUid', 'reviewerName']))

        || (resource.data.status in ['review', 'done']
          && request.resource.data.status == 'in-progress'
          && request.resource.data.keys().hasOnly(['status', 'uid', 'name', 'email', 'startedAt'])
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reviewAt', 'doneAt', 'reviewerUid', 'reviewerName']))
      );

      // Release your own task, or reopen any done task.
      allow delete: if isTeam()
        && (resource.data.uid == request.auth.uid || resource.data.status == 'done');
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
