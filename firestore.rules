rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules → Publish.
// Replace the seven emails with your team's Google account emails (lowercase).
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeam() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'teammate1@gmail.com',
          'teammate2@gmail.com',
          'teammate3@gmail.com',
          'teammate4@gmail.com',
          'teammate5@gmail.com',
          'teammate6@gmail.com',
          'teammate7@gmail.com'
        ];
    }

    // Admins can close any task: it is recorded as completed and approved by them, for
    // when the assignee and the reviewer can't be reached. They must also be on the team list.
    // (Keep this in step with ADMIN_EMAILS in app.js, which decides who sees the button.)
    function isAdmin() {
      return isTeam() && request.auth.token.email.lower() in ['feritbatuhatip@gmail.com'];
    }

    // One document per task, per sprint: sprints/{sprintId}/tasks/{taskId}
    // (e.g. sprints/sprint-2/tasks/E3.2). No document = nobody took it.
    match /sprints/{sprintId}/tasks/{taskId} {
      allow read: if isTeam();

      // Take a free task, or defer it: either way it must be recorded as yours.
      allow create: if isTeam()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && (
          (request.resource.data.keys().hasOnly(['status', 'uid', 'name', 'email', 'startedAt'])
            && request.resource.data.status == 'in-progress'
            && request.resource.data.startedAt == request.time)
          || (request.resource.data.keys().hasOnly(['status', 'uid', 'name', 'email', 'deferredAt'])
            && request.resource.data.status == 'deferred'
            && request.resource.data.deferredAt == request.time)
        );

      // An admin closes a task nobody has touched: it is done at once, completed and
      // approved by the admin, under the assignee's name.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['status', 'uid', 'name', 'email', 'reviewAt', 'doneAt',
                                                 'reviewerUid', 'reviewerName', 'adminClosed'])
        && request.resource.data.status == 'done'
        && request.resource.data.adminClosed == true
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.reviewerName is string
        && request.resource.data.reviewerName.size() <= 60
        && request.resource.data.reviewAt == request.time
        && request.resource.data.doneAt == request.time;

      // An admin closes a task somebody started, sent for review or deferred: it is
      // approved by the admin whoever started it (and whether or not they are its reviewer).
      allow update: if isAdmin()
        && resource.data.status in ['in-progress', 'review', 'deferred']
        && request.resource.data.status == 'done'
        && request.resource.data.adminClosed == true
        && request.resource.data.doneAt == request.time
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.reviewerName is string
        && request.resource.data.reviewerName.size() <= 60
        && request.resource.data.reviewAt == resource.data.get('reviewAt', request.time)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'doneAt', 'reviewAt', 'reviewerUid', 'reviewerName', 'adminClosed', 'deferredAt']);

      // Moves between the three states. Nothing but the listed fields may change.
      //
      //   in-progress -> done      tasks with no reviewer: any team member (the
      //                            claimer may have handed it off without releasing it)
      //   in-progress -> review    the assignee says the work is complete
      //   review -> done           the reviewer approves it: it records who, and
      //                            it can't be the person who completed it
      //   review -> in-progress    changes requested, or the assignee takes it back
      //   done -> in-progress      reopened
      //   in-progress -> deferred  the assignee puts it off (a free task is deferred
      //                            by creating the record, see above)
      //
      // Who is the assignee or the reviewer lives in the sprint file, not in
      // Firestore, so the board enforces that part and these rules enforce the rest.
      allow update: if isTeam() && (
        (resource.data.status == 'in-progress'
          && request.resource.data.status == 'done'
          && request.resource.data.doneAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneAt']))

        || (resource.data.status == 'in-progress'
          && request.resource.data.status == 'review'
          && request.resource.data.reviewAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewAt']))

        || (resource.data.status == 'review'
          && request.resource.data.status == 'done'
          && request.resource.data.doneAt == request.time
          && request.resource.data.reviewerUid == request.auth.uid
          && request.resource.data.reviewerName is string
          && request.resource.data.reviewerName.size() <= 60
          && resource.data.uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'doneAt', 'reviewerUid', 'reviewerName']))

        || (resource.data.status in ['review', 'done']
          && request.resource.data.status == 'in-progress'
          && request.resource.data.keys().hasOnly(['status', 'uid', 'name', 'email', 'startedAt'])
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reviewAt', 'doneAt', 'reviewerUid', 'reviewerName', 'adminClosed']))

        || (resource.data.status == 'in-progress'
          && request.resource.data.status == 'deferred'
          && request.resource.data.deferredAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deferredAt']))
      );

      // Release your own task, reopen any done task, or bring back any deferred one.
      allow delete: if isTeam()
        && (resource.data.uid == request.auth.uid || resource.data.status in ['done', 'deferred']);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
